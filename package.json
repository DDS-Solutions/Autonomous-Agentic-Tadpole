{
  "name": "A-A-Tadpole-OS",
  "private": true,
  "version": "1.1.58",
  "keywords": [
    "react",
    "rust",
    "typescript",
    "mcp",
    "self-hosted",
    "autonomous-agents",
    "ai-safety",
    "swarm-intelligence",
    "ai-agents",
    "moonshots",
    "mythos",
    "local-first",
    "spud",
    "ai-agents-automation",
    "swarm-intelligence-multi-agent-llm-automation",
    "autonomous-agents-system"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "engine": "node scripts/cargo_runner.cjs run --manifest-path server-rs/Cargo.toml",
    "build": "tsc -b && vite build",
    "typecheck:ts7": "node node_modules/typescript7/bin/tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:invariants": "vitest run tests/invariants/",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:py": "python -m unittest discover -s tests/unit",
    "test:rust": "node scripts/cargo_runner.cjs test --manifest-path server-rs/Cargo.toml",
    "test:wasm": "node scripts/cargo_runner.cjs test --manifest-path crates/wasm-codec/Cargo.toml",
    "wasm:build": "wasm-pack build crates/wasm-codec --target web",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "deploy:linuxlite66": "powershell -File scripts/deploy-linuxlite.ps1",
    "docs:api": "python execution/generate_api_reference.py",
    "docs:parity": "python execution/parity_guard.py",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "version:sync": "python execution/sync_version.py",
    "db:backup": "python execution/backup_sqlite.py",
    "db:restore": "python execution/restore_sqlite.py",
    "audit:sovereign": "python execution/sovereign_audit.py",
    "context:verify": "python execution/verify_ai_context.py ."
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@google/genai": "^2.27.0",
    "@huggingface/transformers": "^4.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@tauri-apps/api": "^2.12.1",
    "brace-expansion": "^5.0.9",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "dexie": "^4.4.5",
    "framer-motion": "^14.0.0",
    "groq-sdk": "^1.6.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.50.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "tailwind-merge": "^3.7.0",
    "uuid": "^14.0.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/dagre": "^0.7.54",
    "@types/node": "^26.6.5",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/uuid": "^11.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "dotenv": "^18.0.7",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "scheduler": "^0.28.0",
    "search-insights": "^2.17.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "typescript7": "npm:typescript@^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "vite": "$vite",
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "@tailwindcss/typography": {
      "postcss-selector-parser": "^7.1.6"
    },
    "serialize-javascript": "^7.0.4",
    "esbuild": "^0.25.0",
    "protobufjs": "^8.0.1"
  }
}
