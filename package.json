{
  "name": "A-A-Tadpole-OS",
  "private": true,
  "version": "1.1.58",
  "keywords": [
    "react",
    "rust",
    "typescript",
    "mcp",
    "self-hosted",
    "autonomous-agents",
    "ai-safety",
    "swarm-intelligence",
    "ai-agents",
    "moonshots",
    "mythos",
    "local-first",
    "spud",
    "ai-agents-automation",
    "swarm-intelligence-multi-agent-llm-automation",
    "autonomous-agents-system"
  ],
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "engine": "cargo run --manifest-path server-rs/Cargo.toml",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "build:linux:light": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1",
    "build:linux:upload": "powershell -ExecutionPolicy Bypass -File scripts/build-linux-light.ps1 -Upload",
    "deploy:linuxlite66": "powershell -ExecutionPolicy Bypass -File scripts/deploy-linuxlite.ps1",
    "audit:observability": "echo 'verify_observability_sync.cjs not found - script removed'",
    "docs:api": "python execution/generate_api_reference.py",
    "docs:parity": "python execution/parity_guard.py",
    "docs:build": "vitepress build docs",
    "docs:dev": "vitepress dev docs",
    "docs:preview": "vitepress preview docs",
    "version:sync": "python execution/sync_version.py",
    "db:backup": "python execution/backup_sqlite.py",
    "db:restore": "python execution/restore_sqlite.py"
  },
  "dependencies": {
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@google/genai": "^2.18.0",
    "@huggingface/transformers": "^4.2.0",
    "@msgpack/msgpack": "^3.1.3",
    "@types/dagre": "^0.7.54",
    "brace-expansion": "^5.0.9",
    "clsx": "^2.1.1",
    "d3-force": "^3.0.0",
    "dagre": "^0.8.5",
    "dexie": "^4.4.5",
    "dotenv": "^17.4.2",
    "framer-motion": "^13.1.1",
    "groq-sdk": "^1.5.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "reactflow": "^11.11.4",
    "shaders": "^3.1.457",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.2",
    "ws": "^8.21.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.2.0",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "scheduler": "^0.27.0",
    "search-insights": "^2.17.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.2.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "react": "$react",
    "react-dom": "$react-dom",
    "@types/react": "$@types/react",
    "@types/react-dom": "$@types/react-dom",
    "vite": "$vite",
    "vite-plugin-pwa": {
      "vite": "$vite"
    },
    "serialize-javascript": "^7.0.4",
    "esbuild": "^0.25.0",
    "protobufjs": "^8.0.1",
    "react-router": "8.3.0"
  }
}
