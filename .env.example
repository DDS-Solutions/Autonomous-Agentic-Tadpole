# Environment Variables — Tadpole OS
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# -----------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------
# SECRET — Generate with: openssl rand -hex 32
# This token is required by the Rust engine for all protected API endpoints.
NEURAL_TOKEN=your-secret-token-here
# NEURAL_ENGINE_ACCESS_TOKEN can also be used as an alternative to NEURAL_TOKEN.
NEURAL_ENGINE_ACCESS_TOKEN=your-secret-token-here
NEURAL_TOKEN_OLD=your-previous-token-here
NEURAL_TOKEN_NEW=your-pending-token-here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Optional: Set to true if deployed behind a trusted reverse proxy (Cloudflare/Nginx) to respect CF-Connecting-IP & X-Forwarded-For headers
# TRUST_PROXY_HEADERS=false

# -----------------------------------------------------------------------
# AI Provider Keys
# -----------------------------------------------------------------------
# Get your keys at the following URLs:
# OpenAI: https://platform.openai.com/
# Anthropic: https://console.anthropic.com/
# Google Gemini: https://aistudio.google.com/
# Groq: https://console.groq.com/
# DeepSeek: https://platform.deepseek.com/

OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
REPLICATE_API_KEY=your-replicate-api-key-here
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# -----------------------------------------------------------------------
# Infrastructure
# -----------------------------------------------------------------------
# Comma-separated list of remote Swarm Bunker nodes.
# Format: id:name:hostname
BUNKER_NODES=bunker-1:Swarm Bunker 1:tadpole-linux,bunker-2:Swarm Bunker 2:tadpole-bunker-2

# Optional: Override the default port (8000)
# PORT=8000

# Optional: Override the bind address (default: 127.0.0.1)
# BIND_ADDRESS=127.0.0.1

# Optional: Override the SQLite connection URL
# DATABASE_URL=sqlite:data/tadpole.db

# Optional: Override the static file directory for production serving
# STATIC_DIR=dist

# Optional: Set the absolute root directory of the workspace for script resolution
# WORKSPACE_ROOT=/path/to/tadpole-os

# Optional: Set the absolute root directory for static assets and models
# RESOURCE_ROOT=/path/to/tadpole-assets

# Optional: Heartbeat interval in seconds
# HEARTBEAT_INTERVAL_SECS=3

# Optional: Skip baseline database seeding (useful for high-performance testing)
# SKIP_DB_SEED=false

# Optional: Disable OpenTelemetry stdout exporter
# DISABLE_TELEMETRY=false

# Optional: Directory for cached intelligence assets and model weights
# TADPOLE_CACHE_DIR=.tmp/cache

# -----------------------------------------------------------------------
# Governance & Security
# -----------------------------------------------------------------------
# PRIVACY_MODE — When true, only local providers (localhost/ollama) are allowed.
PRIVACY_MODE=false

# Optional: Force null providers for CI/integration tests.
# TADPOLE_NULL_PROVIDERS=false

# TADPOLE_ALLOW_LOCAL_HTTP — Allow insecure HTTP connections for local LLM providers.
# TADPOLE_ALLOW_LOCAL_HTTP=false

# AGGRESSIVE_SECURITY — Enable additional shell scanner checks.
# AGGRESSIVE_SECURITY=false

# AUDIT_PRIVATE_KEY — Optional signing key for audit-trail identity.
# AUDIT_PRIVATE_KEY=

# ENGINE_RATE_LIMIT — Optional request rate limit override.
# ENGINE_RATE_LIMIT=120

# -----------------------------------------------------------------------
# Governance Limits
# -----------------------------------------------------------------------
AUTO_APPROVE_SAFE_SKILLS=true
MAX_AGENTS=50
MAX_CLUSTERS=10
MAX_SWARM_DEPTH=5
MAX_TASK_LENGTH=32768
DEFAULT_AGENT_BUDGET_USD=1.00

# -----------------------------------------------------------------------
# Optional Vector Memory / Audio Models
# -----------------------------------------------------------------------
# Used only when optional features and local model assets are enabled.
# LANCEDB_DRIFT_THRESHOLD=0.35
# LANCEDB_DEDUPE_THRESHOLD=0.92
# WHISPER_MODEL_PATH=
# PIPER_MODEL_PATH=
# VAD_MODEL_PATH=

# -----------------------------------------------------------------------
# Optional Integrations / Cluster Runtime
# -----------------------------------------------------------------------
# DISCORD_WEBHOOK=
# CLUSTER_ID=local
# KUBERNETES_SERVICE_HOST=

# -----------------------------------------------------------------------
# SME Data Intelligence
# -----------------------------------------------------------------------
# Interval in minutes for the background Ingestion Worker to crawl connectors
SME_SYNC_INTERVAL_MINS=30

# -----------------------------------------------------------------------
# Security Sandboxing
# -----------------------------------------------------------------------
# USE_SANDBOX_DOCKER — Enable Docker container isolated skill execution
# USE_SANDBOX_DOCKER=false
# USE_SANDBOX_WASM — Enable WebAssembly (wasmtime) isolated skill execution
# USE_SANDBOX_WASM=false
# SANDBOX_CPU_LIMIT — CPU quota limits for container (e.g. 0.5 for 50% CPU)
# SANDBOX_CPU_LIMIT=0.5
# SANDBOX_MEMORY_LIMIT_MB — RAM limit for execution sandbox in MB
# SANDBOX_MEMORY_LIMIT_MB=256

# -----------------------------------------------------------------------
# Cognitive Memory
# -----------------------------------------------------------------------
# MEMORY_COMPRESSION_INTERVAL_SECS — Background memory consolidation loop interval
# MEMORY_COMPRESSION_INTERVAL_SECS=60
# MEMORY_COMPRESSION_CEILING — Maximum short term memories before consolidation
# MEMORY_COMPRESSION_CEILING=5

# -----------------------------------------------------------------------
# Telemetry & Runtime Tuning
# -----------------------------------------------------------------------
# TOKIO_THREAD_STACK_SIZE — Custom stack size for Tokio worker threads in bytes (default: 2MB)
# TOKIO_THREAD_STACK_SIZE=2097152

# OTEL_STDOUT_EXPORTER — When true, OpenTelemetry spans are printed to stdout instead of OTLP (default: false)
# OTEL_STDOUT_EXPORTER=false

# OTEL_EXPORTER_OTLP_ENDPOINT — Endpoint for OpenTelemetry OTLP collector (default: http://localhost:4317)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

