{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TadpoleOS",
  "version": "1.1.58",
  "identifier": "io.tadpole.os",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tadpole OS",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
