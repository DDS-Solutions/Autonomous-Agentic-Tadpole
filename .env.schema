# @defaultSensitive=true @defaultRequired=infer
# ---
# Tadpole OS — Environment Schema
# This file documents all environment variables used by the engine.
# It is the single source of truth for configuration, committed to git.
# AI agents can read this schema for context without seeing secret values.
# ---

# -----------------------------------------------------------------------
# Core Engine Configuration
# -----------------------------------------------------------------------

# @required @sensitive @type=string
# Secret token required for all protected engine API endpoints.
# Generate with: openssl rand -hex 32
NEURAL_TOKEN=

# @sensitive @type=string
# Optional dedicated Admin-scope token for destructive host/deploy/script routes.
NEURAL_TOKEN_ADMIN=

# @sensitive @type=string
# Optional ReadOnly-scope token restricted to GET/HEAD observability endpoints.
NEURAL_TOKEN_READONLY=

# @sensitive @type=string
# Alternate access token accepted by the engine alongside NEURAL_TOKEN.
NEURAL_ENGINE_ACCESS_TOKEN=

# @sensitive @type=string
# Previous token kept valid during zero-downtime rotation grace window.
NEURAL_TOKEN_OLD=

# @sensitive @type=string
# Replacement token staged during zero-downtime rotation grace window.
NEURAL_TOKEN_NEW=

# @type=number
# Unix epoch timestamp (seconds) when token rotation was initiated.
NEURAL_TOKEN_ROTATED_AT=

# @type=number @default=300
# Duration (seconds) that NEURAL_TOKEN_OLD remains valid after NEURAL_TOKEN_ROTATED_AT.
NEURAL_TOKEN_GRACE_SECS=

# @type=string @default=http://localhost:5173
# Comma-separated list of allowed CORS origins.
ALLOWED_ORIGINS=

# @type=boolean @default=false
# Trust X-Forwarded-For and CF-Connecting-IP headers from reverse proxies.
TRUST_PROXY_HEADERS=

# @type=string
# Comma-separated list of trusted reverse proxy IP addresses.
TRUSTED_PROXIES=

# @type=string @default=sqlite:data/tadpole.db
# SQLite database connection string.
DATABASE_URL=

# @type=string @default=bunker-1:Swarm Bunker 1:localhost
# Comma-separated list of Swarm Bunker nodes. Format: id:name:hostname
BUNKER_NODES=

# @type=port @default=8000
# HTTP server listen port.
PORT=

# @type=string @default=127.0.0.1
# Network address to bind the HTTP server.
BIND_ADDRESS=

# @type=string @default=dist
# Directory for serving static frontend assets.
STATIC_DIR=

# @type=number @default=3
# Interval (seconds) for engine heartbeat broadcasts to connected UIs.
HEARTBEAT_INTERVAL_SECS=

# @type=number @default=2000
# Maximum number of API requests allowed per minute per IP.
ENGINE_RATE_LIMIT=

# -----------------------------------------------------------------------
# AI Provider API Keys (Sensitive)
# -----------------------------------------------------------------------

# @sensitive @type=string(startsWith=sk-)
# OpenAI API key. Also used as fallback for DeepSeek provider.
OPENAI_API_KEY=

# @sensitive @type=string(startsWith=gsk_)
# High-speed inference key for Groq models (LPU).
GROQ_API_KEY=

# @sensitive @type=string
# Google Cloud / Gemini API key for multimodal reasoning.
GOOGLE_API_KEY=

# @sensitive @type=string(startsWith=sk-ant-)
# Anthropic Claude API key.
ANTHROPIC_API_KEY=

# @sensitive @type=string
# Inception AI API key.
INCEPTION_API_KEY=

# @sensitive @type=string
# DeepSeek API key (falls back to OPENAI_API_KEY if unset).
DEEPSEEK_API_KEY=

# @sensitive @type=string
# Replicate API key for hosted model inference.
REPLICATE_API_KEY=

# @type=url @default=http://localhost:11434
# Base URL of the local Ollama daemon.
OLLAMA_HOST=

# @type=string @default=gemma4:e4b
# Default Ollama model identifier for local inference.
OLLAMA_MODEL=

# @type=number @default=4
# Maximum concurrent model inference requests (1 in privacy mode, 4 otherwise).
INFERENCE_CONCURRENCY=

# @sensitive @type=url
# Discord webhook URL for agent notifications.
DISCORD_WEBHOOK=

# -----------------------------------------------------------------------
# Audio Engine (Optional)
# -----------------------------------------------------------------------

# @type=string
# Path to Piper TTS model binary.
PIPER_MODEL_PATH=

# @type=string
# Path to Whisper speech-to-text model.
WHISPER_MODEL_PATH=

# @type=string
# Path to Voice Activity Detection model.
VAD_MODEL_PATH=

# @type=url
# Loopback HTTP URL for a local OpenAI-compatible TTS sidecar (e.g. Kokoro/Piper FastAPI).
LOCAL_TTS_URL=

# @type=string @default=kokoro
# Model name sent to LOCAL_TTS_URL.
LOCAL_TTS_MODEL=

# @type=url
# Loopback HTTP URL for a local OpenAI-compatible Whisper STT sidecar.
LOCAL_WHISPER_URL=

# @type=string @default=whisper-1
# Model name sent to LOCAL_WHISPER_URL.
LOCAL_WHISPER_MODEL=

# -----------------------------------------------------------------------
# Advanced / Debug
# -----------------------------------------------------------------------

# @type=boolean @default=false
# Enable legacy JSON backup for agent registries alongside SQLite.
LEGACY_JSON_BACKUP=

# @type=boolean @default=false
# Force all LLM providers to NullProvider (CI/test mode).
TADPOLE_NULL_PROVIDERS=

# @type=boolean @default=false
# Automatically approve tools tagged as "safe" in their manifest.
AUTO_APPROVE_SAFE_SKILLS=

# @type=boolean @default=false
# If true, enables active socket canary reachability probing to verify physical air-gap.
AIRGAP_CANARY_PROBING=

# @type=boolean @default=false
# If true, blocks all cloud AI providers and enforces local-only operation.
PRIVACY_MODE=

# @type=boolean @default=false
# Allow insecure HTTP connections for local LLM providers.
TADPOLE_ALLOW_LOCAL_HTTP=

# @type=boolean @default=false
# Disable OpenTelemetry span export (for privacy or performance).
DISABLE_TELEMETRY=

# @type=number @default=50
# Maximum number of agents allowed in the registry.
# Recommended for local execution: 3-5 (8GB-12GB VRAM), 5-10 (16GB-24GB VRAM) to prevent OOM.
MAX_AGENTS=

# @type=number @default=10
# Maximum number of active clusters.
MAX_CLUSTERS=

# @type=number @default=5
# Maximum recursion depth for agent recruitment/spawning.
MAX_SWARM_DEPTH=

# @type=number @default=32768
# Maximum token length for a single task context.
MAX_TASK_LENGTH=

# @type=number @default=1.0
# Default USD budget allocated to newly recruited agents.
DEFAULT_AGENT_BUDGET_USD=

# @type=number @default=0.2
# L2 distance threshold for LanceDB memory deduplication.
LANCEDB_DEDUPE_THRESHOLD=

# @type=number @default=0.85
# L2 distance threshold for LanceDB semantic behavioral drift detection.
LANCEDB_DRIFT_THRESHOLD=

# @type=string @default=http://localhost:4317
# The OpenTelemetry OTLP network exporter endpoint (gRPC).
OTEL_EXPORTER_OTLP_ENDPOINT=

# @type=boolean @default=false
# Enable OpenTelemetry OTLP exporter.
ENABLE_OTLP=

# @type=boolean @default=false
# Print OpenTelemetry spans to stdout instead of OTLP.
OTEL_STDOUT_EXPORTER=

# @type=string @default=
# Comma-separated host[:port] allowlist permitted to receive Admin cluster pull credentials (loopback always allowed).
SWARM_TRUSTED_PEERS=

# -----------------------------------------------------------------------
# Workspace, Sandboxing & Runtime Tuning
# -----------------------------------------------------------------------

# @type=string
# Absolute root directory of the workspace for script and data resolution.
WORKSPACE_ROOT=

# @type=string
# Absolute root directory for static assets and local model weights.
RESOURCE_ROOT=

# @type=string @default=.tmp/cache
# Directory for cached intelligence assets and model weights.
TADPOLE_CACHE_DIR=

# @type=boolean @default=false
# Skip baseline database seeding on boot (useful for high-performance tests).
SKIP_DB_SEED=

# @type=boolean @default=false
# Opt-in migration hotfix reconciler for legacy schemas.
ALLOW_MIGRATION_RECONCILE=

# @type=boolean @default=false
# Execute dynamic agent skills inside isolated Docker micro-containers.
USE_SANDBOX_DOCKER=

# @type=boolean @default=false
# Execute dynamic agent skills inside isolated WebAssembly (Wasmtime) sandboxes.
USE_SANDBOX_WASM=

# @type=boolean @default=false
# Explicitly allow unsandboxed bare-host skill execution fallback.
ALLOW_HOST_SKILL_EXECUTION=

# @type=boolean @default=false
# Development-only bypass for template connector lock-file digest checks.
ALLOW_UNVERIFIED_TEMPLATES=

# @type=number @default=1.0
# CPU core limit for Docker skill sandboxes.
SANDBOX_CPU_LIMIT=

# @type=number @default=512
# Memory limit (MB) for Docker skill sandboxes.
SANDBOX_MEMORY_LIMIT_MB=

# @type=string @default=tadpole-os:1.1.59
# Container image tag used for Docker skill sandboxes.
SANDBOX_IMAGE=

# @type=boolean @default=false
# Enable stricter shell scanner heuristics.
AGGRESSIVE_SECURITY=

# @sensitive @type=string
# Optional Ed25519 signing key for audit-trail identity.
AUDIT_PRIVATE_KEY=

# @type=number @default=300
# Timeout (seconds) for pending human oversight approvals.
OVERSIGHT_TIMEOUT_SECS=

# @type=number @default=24000
# Maximum inline character ceiling before tool observations offload to .tmp/tool_overflow/.
TOOL_OBSERVATION_THRESHOLD_CHARS=

# @type=string @default=local
# Logical cluster identifier for workspace namespacing.
CLUSTER_ID=

# @type=string
# Kubernetes service host (auto-populated inside Kubernetes pods).
KUBERNETES_SERVICE_HOST=

# @type=number @default=30
# Interval (minutes) for background SME connector ingestion sweeps.
SME_SYNC_INTERVAL_MINS=

# @type=boolean @default=false
# Enable provider-backed background cognitive memory consolidation.
ENABLE_COGNITIVE_MEMORY=

# @type=boolean @default=false
# Enable event-triggered continuity job automation.
ENABLE_EVENT_AUTOMATION=

# @type=number @default=60
# Background cognitive memory consolidation interval (seconds, minimum 10).
MEMORY_COMPRESSION_INTERVAL_SECS=

# @type=number @default=5
# Short-term memory entry count threshold before consolidation triggers.
MEMORY_COMPRESSION_CEILING=

# @type=number @default=4
# Number of OS worker threads for the Tokio async runtime (min 4).
TOKIO_WORKER_THREADS=

# @type=number @default=32
# Maximum blocking threads for Tokio blocking I/O pool.
TOKIO_MAX_BLOCKING_THREADS=

# @type=number @default=4
# Stack size (MB) allocated per Tokio worker thread.
TOKIO_THREAD_STACK_SIZE_MB=

# @type=boolean @default=false
# Enable verbose payload debug logging.
TADPOLE_DEBUG_PAYLOADS=
